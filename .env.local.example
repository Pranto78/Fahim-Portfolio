# Copy to .env (or .env.local) and fill in. On Vercel, add the same names under
# Project → Settings → Environment Variables.

# Get a FREE Groq API key at https://console.groq.com  (no credit card needed)
GROQ_API_KEY=your_groq_api_key_here

# Optional — override the model. Default is a free Groq model.
# Other free options: llama-3.1-8b-instant (faster), llama-3.3-70b-versatile (smarter)
GROQ_MODEL=llama-3.3-70b-versatile

# Environment switch: LOCAL=true/LIVE=false → test DB; LOCAL=false/LIVE=true → live DB
LOCAL=true
LIVE=false

# MongoDB Atlas (shared with remoteControl). Without it the site uses data/*.ts.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/

# Optional override. Default: "portfolio" when live, "portfolio_dev" when local.
# MONGODB_DB=

# Same value as CONTROL_SECRET in remoteControl. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTROL_SECRET=
