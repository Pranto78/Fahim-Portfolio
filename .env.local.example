# Get a FREE Groq API key at https://console.groq.com  (no credit card needed)
GROQ_API_KEY=your_groq_api_key_here

# Optional — override the model. Default is a free Groq model.
# Other free options: llama-3.1-8b-instant (faster), llama-3.3-70b-versatile (smarter)
GROQ_MODEL=llama-3.3-70b-versatile
